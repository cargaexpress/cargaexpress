  <diagram id="b2Js5y405mTXac_OoG52" name="DATABASE_MODEL_DER">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    BRAND ||--o{ ORDER : has\n    DISTRIBUTION_CENTER ||--o{ ORDER : serves\n    DISTRIBUTION_CENTER ||--o{ DISPATCH : manages\n    SHIPMENT_TYPE ||--o{ ORDER : classifies\n    CARRIER ||--o{ DISPATCH : handles\n    CARRIER ||--o{ SHIPPING_LABEL : ships\n    CARRIER ||--o{ STATE_MAPPING : translates\n    ORDER ||--|| ORDER_RECIPIENT : has\n    ORDER ||--o{ ORDER_LINE : contains\n    ORDER ||--o{ SHIPPING_LABEL : emits\n    ORDER_LINE ||--o{ PICKING_TASK : tracks\n    ORDER_LINE ||--o{ SHIPPING_LABEL_ITEM : included_in\n    DISPATCH ||--o{ SHIPPING_LABEL : assigns\n    SHIPPING_LABEL ||--o{ SHIPPING_LABEL_ITEM : contains\n\n    BRAND {\n        bigint brand_id PK\n        varchar name\n        varchar tier\n        bool is_active\n        datetime created_at\n    }\n\n    DISTRIBUTION_CENTER {\n        bigint dc_id PK\n        varchar code\n        varchar name\n        varchar city\n        char(2) country_code\n    }\n\n    SHIPMENT_TYPE {\n        varchar shipment_type_code PK\n        varchar description\n    }\n\n    CARRIER {\n        bigint carrier_id PK\n        varchar name\n        varchar integration_type\n        varchar status\n        datetime created_at\n    }\n\n    ORDER {\n        bigint order_id PK\n        bigint brand_id FK\n        bigint dc_id FK\n        varchar shipment_type_code FK\n        varchar brand_order_ref\n        char(2) destination_country\n        varchar destination_region\n        numeric(12,2) freight_value\n        varchar status\n        datetime created_at\n    }\n\n    ORDER_RECIPIENT {\n        bigint order_id PK, FK\n        varchar full_name\n        varchar email\n        varchar phone\n        varchar address_line\n        varchar city\n    }\n\n    ORDER_LINE {\n        bigint order_line_id PK\n        bigint order_id FK\n        int line_number\n        varchar sku\n        varchar description\n        int quantity_ordered\n    }\n\n    PICKING_TASK {\n        bigint picking_id PK\n        bigint order_line_id FK\n        varchar picker_ref\n        int quantity_picked\n        varchar status\n        datetime started_at\n        datetime completed_at\n    }\n\n    DISPATCH {\n        bigint dispatch_id PK\n        bigint dc_id FK\n        bigint carrier_id FK\n        datetime dispatched_at\n    }\n\n    SHIPPING_LABEL {\n        bigint label_id PK\n        bigint order_id FK\n        bigint carrier_id FK\n        bigint dispatch_id FK\n        varchar tracking_number\n        varchar status\n        numeric(8,3) weight_kg\n        datetime created_at\n    }\n\n    SHIPPING_LABEL_ITEM {\n        bigint label_id PK, FK\n        bigint order_id FK\n        bigint order_line_id PK, FK\n        int quantity\n    }\n\n    STATE_MAPPING {\n        bigint id PK\n        bigint carrier_id FK\n        varchar raw_status\n        varchar canonical_status\n        datetime created_at\n        datetime updated_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="x_51Opd_f3Kt6QPEMRAV-1">
