#!/usr/bin/env bash
# Validates the commit message according to docs/contributing/commit-convention.md
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

file="$1"
title="$(head -n1 "$file")"

# Git's automatic commits (merge, revert, fixup) are allowed.
case "$title" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

fail() {
  echo "Invalid commit message: $1" >&2
  echo "  Received title: \"$title\"" >&2
  echo "  Format: type(optional scope): description in English, imperative, max 50 characters, no trailing period" >&2
  echo "  Types: feat fix perf build ci docs refactor style test chore" >&2
  echo "  Guide: docs/contributing/commit-convention.md" >&2
  exit 1
}

pattern='^(feat|fix|perf|build|ci|docs|refactor|style|test|chore)(\([a-z0-9-]+\))?: .+'
[[ "$title" =~ $pattern ]] || fail "must start with type(scope): description"

[ "${#title}" -le 50 ] || fail "the title has ${#title} characters (maximum 50)"

trailing='[.…]$'
[[ "$title" =~ $trailing ]] && fail "the title must not end with a period or ellipsis"

description="${title#*: }"

# A commit cannot be just a story or task number.
ticket_only='^(HU|US|RIWI)[-_ ]?[0-9]+[[:space:]]*$'
number_only='^#?[0-9]+$'
if [[ "$description" =~ $ticket_only ]] || [[ "$description" =~ $number_only ]]; then
  fail "describe the change; the story number alone is not enough"
fi

[[ "$description" =~ ^[a-z] ]] || fail "the description must start in lowercase"

first_word="$(echo "$description" | awk '{print tolower($1)}')"
case "$first_word" in
  added|fixed|changed|removed|updated|created|deleted|adds|fixes|changes|removes|updates|creates|deletes|adding|fixing|changing|removing|updating|creating|deleting)
    fail "use the imperative mood (add, fix, change, remove), not \"$first_word\"" ;;
esac

if [ "$(sed -n '2p' "$file")" != "" ] && [ "$(wc -l < "$file")" -gt 1 ]; then
  fail "leave a blank line between the title and the body"
fi

exit 0
